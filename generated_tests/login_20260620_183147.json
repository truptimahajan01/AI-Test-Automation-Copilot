"{\"test_cases\": {\n    \"positive\": [\n      {\n        \"id\": \"TC_LOGIN_P_001\",\n        \"name\": \"Successful login with valid username and password.\",\n        \"description\": \"Verifies that a registered user can log in successfully using correct username and password.\",\n        \"preconditions\": \"User 'standard_user' exists with password 'StrongPass123!'.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"standard_user\", \"password\": \"StrongPass123!\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 200,\n          \"body_contains\": {\"success\": true, \"message\": \"Login successful\"},\n          \"body_has_fields\": [\"token\", \"user.id\", \"user.username\"]\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_P_002\",\n        \"name\": \"Successful login with valid email and password.\",\n        \"description\": \"Verifies that a registered user can log in successfully using correct email and password (assuming email can be used as an identifier).\",\n        \"preconditions\": \"User 'email_user@example.com' exists with password 'StrongPass123!'.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"email\": \"email_user@example.com\", \"password\": \"StrongPass123!\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 200,\n          \"body_contains\": {\"success\": true, \"message\": \"Login successful\"},\n          \"body_has_fields\": [\"token\", \"user.id\", \"user.email\"]\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_P_003\",\n        \"name\": \"Successful login after recent password change.\",\n        \"description\": \"Verifies a user can log in with their newly updated password immediately after a password change operation.\",\n        \"preconditions\": \"User 'reset_user' changed their password from 'OldPass' to 'NewStrongPass456!'.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"reset_user\", \"password\": \"NewStrongPass456!\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 200,\n          \"body_contains\": {\"success\": true, \"message\": \"Login successful\"},\n          \"body_has_fields\": [\"token\"]\n        }\n      }\n    ],\n    \"negative\": [\n      {\n        \"id\": \"TC_LOGIN_N_001\",\n        \"name\": \"Login with incorrect password.\",\n        \"description\": \"Verifies that login fails with a valid username but an incorrect password.\",\n        \"preconditions\": \"User 'testuser' exists with password 'CorrectPassword123!'.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"testuser\", \"password\": \"WrongPassword456\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 401,\n          \"body_contains\": {\"success\": false, \"message\": \"Invalid username or password\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_N_002\",\n        \"name\": \"Login with non-existent username/email.\",\n        \"description\": \"Verifies that login fails if the provided username or email does not correspond to any registered account.\",\n        \"preconditions\": \"No user 'non_existent_user' exists.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"non_existent_user\", \"password\": \"AnyPassword123\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 401,\n          \"body_contains\": {\"success\": false, \"message\": \"Invalid username or password\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_N_003\",\n        \"name\": \"Login with empty username/email.\",\n        \"description\": \"Verifies that login fails when the username/email field in the request payload is empty.\",\n        \"preconditions\": \"N/A\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"\", \"password\": \"StrongPass123!\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 400,\n          \"body_contains\": {\"success\": false, \"message\": \"Username/email is required\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_N_004\",\n        \"name\": \"Login with empty password.\",\n        \"description\": \"Verifies that login fails when the password field in the request payload is empty.\",\n        \"preconditions\": \"User 'testuser' exists.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"testuser\", \"password\": \"\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 400,\n          \"body_contains\": {\"success\": false, \"message\": \"Password is required\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_N_005\",\n        \"name\": \"Login with missing username/email in request body.\",\n        \"description\": \"Verifies that login fails if the username/email field is entirely absent from the JSON payload.\",\n        \"preconditions\": \"N/A\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"password\": \"StrongPass123!\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 400,\n          \"body_contains\": {\"success\": false, \"message\": \"Username/email is required\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_N_006\",\n        \"name\": \"Login with missing password in request body.\",\n        \"description\": \"Verifies that login fails if the password field is entirely absent from the JSON payload.\",\n        \"preconditions\": \"User 'testuser' exists.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"testuser\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 400,\n          \"body_contains\": {\"success\": false, \"message\": \"Password is required\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_N_007\",\n        \"name\": \"Login with a disabled/locked account.\",\n        \"description\": \"Verifies that login fails for an account that has been disabled or locked (e.g., by an administrator or due to too many failed attempts).\",\n        \"preconditions\": \"User 'locked_user' exists and is currently locked.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"locked_user\", \"password\": \"CorrectPassword123!\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 403,\n          \"body_contains\": {\"success\": false, \"message\": \"Account is locked or disabled\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_N_008\",\n        \"name\": \"Login with malformed JSON request body.\",\n        \"description\": \"Verifies that the API handles invalid JSON payloads gracefully, returning a bad request error.\",\n        \"preconditions\": \"N/A\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": \"{\\\"username\\\": \\\"testuser\\\", \\\"password\\\": \\\"StrongPass123!\"}\n        ],\n        \"expected_result\": {\n          \"status_code\": 400,\n          \"body_contains\": {\"success\": false, \"message\": \"Invalid JSON format\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_N_009\",\n        \"name\": \"Login with unsupported HTTP method.\",\n        \"description\": \"Verifies that the API only accepts the POST method for login, rejecting other methods like GET.\",\n        \"preconditions\": \"N/A\",\n        \"steps\": [\n          {\"action\": \"Send GET request to /api/login\", \"payload\": null}\n        ],\n        \"expected_result\": {\n          \"status_code\": 405,\n          \"body_contains\": {\"success\": false, \"message\": \"Method not allowed\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_N_010\",\n        \"name\": \"Login with an account requiring 2FA but no 2FA token provided.\",\n        \"description\": \"Verifies that login fails or prompts for 2FA if the account has 2FA enabled and no token is supplied in the request.\",\n        \"preconditions\": \"User '2fa_user' exists with 2FA enabled.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"2fa_user\", \"password\": \"StrongPass123!\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 401,\n          \"body_contains\": {\"success\": false, \"message\": \"Two-factor authentication required\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_N_011\",\n        \"name\": \"Login with an invalid 2FA token.\",\n        \"description\": \"Verifies that login fails if an incorrect or expired 2FA token is provided for a 2FA-enabled account.\",\n        \"preconditions\": \"User '2fa_user' exists with 2FA enabled.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"2fa_user\", \"password\": \"StrongPass123!\", \"otp_token\": \"123456\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 401,\n          \"body_contains\": {\"success\": false, \"message\": \"Invalid two-factor authentication token\"}\n        }\n      }\n    ],\n    \"edge\": [\n      {\n        \"id\": \"TC_LOGIN_E_001\",\n        \"name\": \"Login with minimum length valid password.\",\n        \"description\": \"Verifies successful login with a password that meets the assumed minimum length requirement (e.g., 8 characters).\",\n        \"preconditions\": \"User 'minpass_user' exists with password 'MinPass!'. (8 characters)\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"minpass_user\", \"password\": \"MinPass!\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 200,\n          \"body_contains\": {\"success\": true, \"message\": \"Login successful\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_E_002\",\n        \"name\": \"Login with maximum length valid password.\",\n        \"description\": \"Verifies successful login with a password that meets the assumed maximum length requirement (e.g., 64 characters).\",\n        \"preconditions\": \"User 'maxpass_user' exists with a 64-character password 'A1!b2@c3#d4$e5%f6^g7&h8*i9(j0)k1_l2+m3-n4=o5{p6}q7[r8]s9|t0~'.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"maxpass_user\", \"password\": \"A1!b2@c3#d4$e5%f6^g7&h8*i9(j0)k1_l2+m3-n4=o5{p6}q7[r8]s9|t0~\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 200,\n          \"body_contains\": {\"success\": true, \"message\": \"Login successful\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_E_003\",\n        \"name\": \"Login with password case sensitivity (should fail if case differs).\",\n        \"description\": \"Verifies that passwords are treated as case-sensitive.\",\n        \"preconditions\": \"User 'casesen_user' exists with password 'Password123!'.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"casesen_user\", \"password\": \"password123!\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 401,\n          \"body_contains\": {\"success\": false, \"message\": \"Invalid username or password\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_E_004\",\n        \"name\": \"Brute-force protection: Multiple failed login attempts for same user lead to account lock/rate limiting.\",\n        \"description\": \"Verifies that the system implements brute-force protection, either by rate limiting requests (429) or locking the account (403) after a defined number of failed attempts.\",\n        \"preconditions\": \"User 'brute_user' exists with password 'CorrectPassword123!'. System has a configured threshold (e.g., 5 failed attempts) for account lock or rate limit.\",\n        \"steps\": [\n          {\"action\": \"Repeat POST /api/login with {\\\"username\\\": \\\"brute_user\\\", \\\"password\\\": \\\"WrongPass\\\"} for 6 times.\"}\n        ],\n        \"expected_result\": {\n          \"status_code\": [429, 403],\n          \"body_contains_any_of\": [{\"message\": \"Too many login attempts. Please try again later.\"}, {\"message\": \"Account locked due to too many failed attempts.\"}]\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_E_005\",\n        \"name\": \"Login with an old password after a password reset (should fail).\",\n        \"description\": \"Verifies that an old password cannot be used for login after the user has successfully reset their password.\",\n        \"preconditions\": \"User 'pw_reset_user' existed with 'OldPassword123!', then successfully reset to 'NewPassword456!'.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"pw_reset_user\", \"password\": \"OldPassword123!\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 401,\n          \"body_contains\": {\"success\": false, \"message\": \"Invalid username or password\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_E_006\",\n        \"name\": \"Login with username containing leading/trailing whitespace (should fail or be trimmed based on spec).\",\n        \"description\": \"Tests how the system handles usernames with leading/trailing whitespace. Assuming whitespace is not allowed or not trimmed implicitly for security.\",\n        \"preconditions\": \"User 'whitespace_user' exists with password 'StrongPass123!'.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"  whitespace_user  \", \"password\": \"StrongPass123!\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 401,\n          \"body_contains\": {\"success\": false, \"message\": \"Invalid username or password\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_E_007\",\n        \"name\": \"Login with password containing leading/trailing whitespace (should fail).\",\n        \"description\": \"Tests how the system handles passwords with leading/trailing whitespace. Passwords should typically not be trimmed.\",\n        \"preconditions\": \"User 'testuser' exists with password 'StrongPass123!'.\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"testuser\", \"password\": \" StrongPass123! \"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 401,\n          \"body_contains\": {\"success\": false, \"message\": \"Invalid username or password\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_E_008\",\n        \"name\": \"SQL Injection attempt in username/password.\",\n        \"description\": \"Verifies that the system is robust against common SQL injection attempts in the username and password fields.\",\n        \"preconditions\": \"N/A\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login\", \"payload\": {\"username\": \"' OR '1'='1 --\", \"password\": \"password\"}}\n        ],\n        \"expected_result\": {\n          \"status_code\": 401,\n          \"body_contains\": {\"success\": false, \"message\": \"Invalid username or password\"}\n        }\n      },\n      {\n        \"id\": \"TC_LOGIN_E_009\",\n        \"name\": \"Login with content-type other than application/json.\",\n        \"description\": \"Verifies that the API correctly rejects requests with unsupported Content-Type headers.\",\n        \"preconditions\": \"N/A\",\n        \"steps\": [\n          {\"action\": \"Send POST request to /api/login with Content-Type: text/plain\", \"payload\": \"username=testuser&password=StrongPass123!\"}\n        ],\n        \"expected_result\": {\n          \"status_code\": 415,\n          \"body_contains\": {\"success\": false, \"message\": \"Unsupported Media Type\"}\n        }\n      }\n    ]\n  }\n}"